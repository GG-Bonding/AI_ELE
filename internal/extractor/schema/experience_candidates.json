{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-experience-engine.local/schemas/experience_candidates.json",
  "title": "ExperienceCandidates",
  "type": "object",
  "required": ["experiences"],
  "additionalProperties": false,
  "properties": {
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "trigger", "content", "confidence", "scope"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["EPISODIC", "SEMANTIC", "PROCEDURAL", "FAILURE", "CONSTRAINT", "PREFERENCE"]
          },
          "trigger": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "scope": {
            "type": "string",
            "enum": ["GLOBAL", "TENANT", "TEAM", "USER", "AGENT", "TOOL", "TASK_TYPE"]
          },
          "scope_key": {
            "type": "string"
          }
        }
      }
    }
  }
}
